            </dependency>
            <dependency>
                <groupId>top.tangyh.basic</groupId>
                <artifactId>lamp-webmvc</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>top.tangyh.basic</groupId>
